# Copy this file to .env.local and fill in what you have. Everything is optional on a laptop.

# 1 = demo mode: every outside service is replaced by a synthetic stand-in (no keys needed). See server/beta/demo.ts.
DEMO_MODE=
# SQLite file (default ./data/trustline.db)
# TRUSTLINE_DB_PATH=data/trustline.db

# "Sign in with Figma" (designer beta). Create an app at https://www.figma.com/developers/apps
# Callback URL: http://localhost:3000/api/beta/figma/callback
# Without these, the beta offers a Figma personal access token instead.
FIGMA_CLIENT_ID=
FIGMA_CLIENT_SECRET=

# "Connect" buttons for the other sources (designer beta). Each needs a free developer app; steps in docs/CONNECTORS.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
WEBFLOW_CLIENT_ID=
WEBFLOW_CLIENT_SECRET=
MIRO_CLIENT_ID=
MIRO_CLIENT_SECRET=
DRIBBBLE_CLIENT_ID=
DRIBBBLE_CLIENT_SECRET=

# "Confirm with your bank" (identity through open banking, Berlin Group NextGenPSD2).
# Only the account owner's name is requested (allAccountsWithOwnerName): no balances, no transactions.
TBC_OB_BASE_URL=
TBC_OB_TOKEN_URL=
TBC_OB_CLIENT_ID=
TBC_OB_CLIENT_SECRET=
TBC_OB_API_KEY=
BOG_OB_BASE_URL=
BOG_OB_TOKEN_URL=
BOG_OB_CLIENT_ID=
BOG_OB_CLIENT_SECRET=
BOG_OB_API_KEY=

# Claude reads payment emails and writes the lender explanation. Optional: rules are used without it.
ANTHROPIC_API_KEY=

# Approximate currency rates to USD, if you want to override the built-in ones
# FX_GEL_USD=0.37
# FX_EUR_USD=1.10

# Master key for the vault that encrypts access tokens (64 hex characters).
# Leave empty on a laptop: a key file is created in ./data/vault.key automatically.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TRUSTLINE_SECRET=

# Public address when hosted (used for the Figma callback), e.g. https://trustline.example.com
PUBLIC_URL=

# Optional blockchain readers
TRONGRID_API_KEY=
SOLANA_RPC_URL=

# Daily robot: how often it checks, and how old data must be before it re-reads
ROBOT_CHECK_MINUTES=10
ROBOT_MAX_AGE_HOURS=24
